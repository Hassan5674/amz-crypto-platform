<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to existing files and directories (like /assets/*)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route ALL /api/... requests directly to root api.php
    RewriteRule ^api/(.*)$ api.php [QSA,L]

    # Send all other requests to index.html for React SPA routing
    RewriteRule ^ /index.html [L]
</IfModule>
