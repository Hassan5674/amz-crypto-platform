# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: Cloud Run / Domain URL
APP_URL=http://localhost:3000

# Live SMTP Configuration (e.g., Gmail, SendGrid, Mailgun, Amazon SES, or Custom SMTP)
# For Gmail:
# - Set SMTP_HOST=smtp.gmail.com
# - Set SMTP_PORT=587 (or 465)
# - Set SMTP_USER=your_email@gmail.com
# - Set SMTP_PASS=your_16_character_google_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="AMZDistributor Security <no-reply@amzdistributor.com>"
SESSION_SECRET=
FRONTEND_URL=

# NOWPayments Official Crypto Gateway Configuration
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=
NOWPAYMENTS_SANDBOX=false
# Optional: NOWPayments Mass Payout Bearer Credentials (if using automated API disbursements)
NOWPAYMENTS_JWT_TOKEN=
NOWPAYMENTS_EMAIL=
NOWPAYMENTS_PASSWORD=
# Optional: 2FA TOTP secret from NOWPayments dashboard (for 100% automated payout verification)
NOWPAYMENTS_2FA_SECRET=
