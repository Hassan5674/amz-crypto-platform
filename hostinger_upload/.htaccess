<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Ensure Authorization header is passed to PHP scripts on shared hosting
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 1. Route ALL /api/* requests directly to root api.php router
    RewriteRule ^api/?(.*)$ api.php [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},QSA,L]

    # 2. Allow direct access to real existing files (e.g. /assets/index-*.js, /favicon.ico)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Allow real directories (excluding /api)
    RewriteCond %{REQUEST_URI} !^/api
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Route all frontend SPA routes to index.html
    RewriteRule ^ /index.html [L]
</IfModule>
